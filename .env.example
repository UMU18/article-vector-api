# ==============================================================================
# Article Ingestion & Vector Search API - environment configuration
# Copy to `.env` for local (non-Docker) runs. Inside docker compose the service
# hostnames below already point at the compose network.
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT MAPPINGS (Docker Compose only)
# ------------------------------------------------------------------------------
# These variables control ONLY which port on YOUR machine each container is
# published to. Docker Compose reads them automatically from this file.
#
# They do NOT change how the services talk to each other: inside the compose
# network the API/worker always connect to postgres:5432, redis:6379, etc.
# (the internal *_PORT values below stay untouched).
#
# Example: your laptop already runs a local PostgreSQL on 5432 -> remap the
# container to 5433 by uncommenting the line below, then connect GUI clients
# (DBeaver/pgAdmin) to localhost:5433.
#
# API_HOST_PORT=8000
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# RABBITMQ_HOST_PORT=5673
# RABBITMQ_MGMT_HOST_PORT=15673
# QDRANT_HOST_PORT=6335
# QDRANT_GRPC_HOST_PORT=6336
# FLOWER_HOST_PORT=5556

APP_ENV=development
APP_NAME=article-vector-api
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- PostgreSQL (source of truth) -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=articles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis (search cache) ----------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- RabbitMQ (message broker) ----------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# --- Qdrant (vector database) ------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=articles

# --- Mock embedding ----------------------------------------------------------
EMBEDDING_DIMENSION=128
EMBEDDING_TIMEOUT_SECONDS=5

# --- Celery resilience -------------------------------------------------------
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=true
CELERY_RETRY_BACKOFF_MAX=60
CELERY_TASK_SOFT_TIME_LIMIT=30
CELERY_TASK_TIME_LIMIT=60
CELERY_RESULT_BACKEND_DB=1

# --- Search / caching --------------------------------------------------------
SEARCH_CACHE_TTL=300
SEARCH_TOP_K=10

# --- Seeder ------------------------------------------------------------------
FAKER_LOCALE=id_ID
